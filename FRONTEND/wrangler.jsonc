{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badminton-cloud",
  "compatibility_date": "2026-05-13",
  "main": "./src/worker.ts",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
